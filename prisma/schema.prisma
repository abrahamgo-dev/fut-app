datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  TRAINER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum ReservaStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Short public bio, shown on the "Entrenadores" / "Próximas sesiones" cards for TRAINER-role users.
  bio           String?   @db.Text
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  trainerAvailability TrainerAvailability[] @relation("TrainerAvailability")
  bookingsAsUser      Booking[]             @relation("BookingUser")
  bookingsAsTrainer   Booking[]             @relation("BookingTrainer")
  sesiones            Sesion[]              @relation("SesionTrainer")
  reservas            Reserva[]             @relation("ReservaUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Trainer's recurring weekly bookable window. citySlug matches City.slug in
// data/cities.ts — cities are static TS data, not a DB table, so there's
// intentionally no FK here.
model TrainerAvailability {
  id                  String   @id @default(cuid())
  trainerId           String
  trainer             User     @relation("TrainerAvailability", fields: [trainerId], references: [id], onDelete: Cascade)
  citySlug             String
  dayOfWeek           Int      // 0 = Sunday … 6 = Saturday
  startTime           String   // "HH:mm", 24h, local wall time e.g. "07:00"
  endTime             String   // "HH:mm", 24h, local wall time e.g. "09:00"
  slotDurationMinutes Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([trainerId])
  @@index([citySlug])
}

// A physical training venue. citySlug matches City.slug in data/cities.ts —
// cities are static TS data, not a DB table, so there's intentionally no FK here.
model Sede {
  id        String   @id @default(cuid())
  name      String
  citySlug  String
  address   String
  image     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sesiones Sesion[]

  @@index([citySlug])
}

// An upcoming, publicly-listed training session/event: one sede + one trainer
// at a given time. Shown on the marketing site as "Próximas sesiones".
model Sesion {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  levelLabel  String?
  capacity    Int?
  /// Price in cents (MXN). Null or 0 means free for now — no Stripe checkout is offered.
  priceCents  Int?
  startsAt    DateTime
  durationMinutes Int  @default(60)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sedeId    String
  sede      Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User   @relation("SesionTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  reservas  Reserva[]

  @@index([sedeId])
  @@index([trainerId])
  @@index([startsAt])
}

// A user's paid (or pending-payment) spot in a Sesion. Created right before
// redirecting to Stripe Checkout; the webhook is the source of truth for
// flipping it to PAID once payment actually completes.
model Reserva {
  id                      String        @id @default(cuid())
  userId                  String
  user                    User          @relation("ReservaUser", fields: [userId], references: [id], onDelete: Cascade)
  sesionId                String
  sesion                  Sesion        @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  status                  ReservaStatus @default(PENDING)
  amountCents             Int
  stripeCheckoutSessionId String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([sesionId])
  @@index([userId])
}

// A submission from the public "bolsa de trabajo" form (see
// components/JobApplicationForm.tsx and app/api/postulacion/route.ts).
model JobApplication {
  id        String   @id @default(cuid())
  name      String
  phone     String
  /// City name from data/cities.ts — cities are static TS data, not a DB table, so there's
  /// intentionally no FK here.
  cityName  String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  trainerId   String
  trainer     User          @relation("BookingTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  citySlug    String
  startsAt    DateTime
  endsAt      DateTime
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now())
  cancelledAt DateTime?

  @@index([trainerId, startsAt])
  @@index([userId])
  @@index([citySlug])
}

// A contact form submission (see components/Prueba.tsx). Email is required;
// phone is optional. phoneNormalized is the last-10-digits form of `phone`,
// used to catch the same phone number submitting multiple requests
// regardless of how it was typed (spaces, dashes, +52, etc), when a phone is
// given. This is a soft anti-abuse signal, not a hard guarantee — see
// app/api/lead/route.ts for how it's applied.
model Lead {
  id                String   @id @default(cuid())
  name              String
  age               String
  email             String?
  phone             String?
  phoneNormalized   String?
  cityName          String?
  preferredSchedule String?
  ipAddress         String?
  isDuplicatePhone  Boolean  @default(false)
  isRateLimitedIp   Boolean  @default(false)
  read              Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([phoneNormalized])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}
