datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  TRAINER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  trainerAvailability TrainerAvailability[] @relation("TrainerAvailability")
  bookingsAsUser      Booking[]             @relation("BookingUser")
  bookingsAsTrainer   Booking[]             @relation("BookingTrainer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Trainer's recurring weekly bookable window. citySlug matches City.slug in
// data/cities.ts — cities are static TS data, not a DB table, so there's
// intentionally no FK here.
model TrainerAvailability {
  id                  String   @id @default(cuid())
  trainerId           String
  trainer             User     @relation("TrainerAvailability", fields: [trainerId], references: [id], onDelete: Cascade)
  citySlug             String
  dayOfWeek           Int      // 0 = Sunday … 6 = Saturday
  startTime           String   // "HH:mm", 24h, local wall time e.g. "07:00"
  endTime             String   // "HH:mm", 24h, local wall time e.g. "09:00"
  slotDurationMinutes Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([trainerId])
  @@index([citySlug])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  trainerId   String
  trainer     User          @relation("BookingTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  citySlug    String
  startsAt    DateTime
  endsAt      DateTime
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now())
  cancelledAt DateTime?

  @@index([trainerId, startsAt])
  @@index([userId])
  @@index([citySlug])
}
