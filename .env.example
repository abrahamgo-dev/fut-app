# Copy this file to .env.local and fill in real values. .env.local is gitignored — never commit real secrets.

# Resend (resend.com) — create an account, generate an API key under API Keys.
RESEND_API_KEY=

# Where lead form submissions get emailed. Defaults to onboarding@resend.dev as the sender
# until you verify your own domain in Resend (see app/api/lead/route.ts).
LEAD_NOTIFICATION_EMAIL=

# Google Analytics 4 Measurement ID (Admin > Data Streams in your GA4 property). Looks like G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# Local-dev test-data switch (see lib/launchFlags.ts): while true (the default
# if unset), panel/cuenta seeds fake reservations/sessions locally so there's
# something to look at without real bookings. Can never take effect in
# production, regardless of this value — the site is fully live there. Set to
# "false" locally if you want a clean DB with no seeded mock data.
NEXT_PUBLIC_PRELAUNCH_MODE=true

# --- Reservations / login / dashboards (hidden feature, see /reservar and /panel) ---

# Postgres on Neon (neon.tech) — create a free project. Neon gives you two
# connection strings: use the pooled one here (runtime queries)...
# These values must also be added in Vercel Project Settings > Environment Variables.
DATABASE_URL=
# ...and the direct/unpooled one here (needed by `prisma migrate`, which can
# fail against a pooled/PgBouncer connection).
DIRECT_DATABASE_URL=

# Auth.js secret — generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Base URL of the app for auth callbacks. Optional locally (defaults to
# http://localhost:3000); required once deployed unless on Vercel, where it's
# auto-detected from VERCEL_URL.
AUTH_URL=

# Google OAuth Client ID/Secret — Google Cloud Console > APIs & Services >
# Credentials > Create OAuth client ID (Web application). Add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails auto-promoted to ADMIN on their first-ever sign-in.
# Set this BEFORE anyone signs in for the first time on a fresh database.
ADMIN_EMAILS=

# Optional: comma-separated emails auto-promoted to TRAINER on first-ever sign-in.
# ADMIN_EMAILS has precedence if an email appears in both variables.
TRAINER_EMAILS=

# --- Payments (Stripe Checkout, see /eventos/[id], lib/stripe.ts) ---

# Stripe (stripe.com) test-mode secret key — Developers > API keys. Starts with sk_test_.
# Required for the "Reserva" button on event pages to work; without it, checkout
# throws a clear error instead of the site failing to build.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint (app/api/stripe/webhook/route.ts) — from
# Developers > Webhooks > your endpoint, or `stripe listen` output when testing locally.
STRIPE_WEBHOOK_SECRET=

# --- WhatsApp Business auto-replies ---
# Provider: meta, twilio or mock. Default is meta.
WHATSAPP_PROVIDER=meta
# Enable/disable automatic replies. Leave unset or set true to enable.
WHATSAPP_AUTO_REPLY_ENABLED=true
# Token used to verify the webhook subscription callback.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta Business API credentials (for WhatsApp Cloud API).
META_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Twilio credentials (optional alternative provider).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
